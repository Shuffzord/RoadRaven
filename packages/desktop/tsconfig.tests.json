{
	// Typecheck gate for tests. Not wired into `tsc --noEmit` (the base
	// tsconfig.json), pre-commit, or CI — a separate `typecheck:tests` script
	// (see package.json) so it can be adopted per-directory as test files are
	// cleaned up. The `include` list below is an ALLOWLIST: it only contains
	// test directories/files that typecheck cleanly today. Grow it as more
	// test files are fixed; do not add a directory/file here until it is
	// clean (`bun run test:typecheck:tests` must stay green).
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["vitest/globals", "node"]
	},
	"include": [
		"src",
		"../../shared",
		"tests/ui",
		"tests/helpers",
		"tests/unit/hooks",
		"tests/unit/lib",
		"tests/unit/store",
		"tests/unit/mainview",
		"tests/unit/ui/ContextMenu.test.tsx",
		"tests/unit/ui/ContextMenu.keyboard.test.tsx",
		"tests/unit/ui/EventLogDrawer.test.tsx",
		"tests/unit/ui/SidePanel.edit-mode.test.tsx",
		"tests/unit/ui/viewer-smoke.test.tsx",
		"tests/unit/ui/RoadmapNodePulse.test.tsx",
		"tests/integration/eventLog-selection.test.ts"
	],
	"exclude": ["node_modules", "dist", "build"]
}
