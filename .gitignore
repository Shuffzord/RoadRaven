# Test artifacts
playwright-report/
test-results/

# Roadmap auto-generated backups
*.bak.json
# Fallow analysis cache (incremental, regenerated on every run)
.fallow/

# Local developer environment overrides (not committed)
.env.local

# Build artifacts (Phase 5)
packages/core/dist/
packages/desktop/artifacts/
# Generated MCP server bundle (built by `bun run build:mcp`, v0.6)
packages/desktop/assets/mcp/

# --- Public release exclusions (alpha v0.5) ---
# Internal GSD planning artifacts & strategy docs (pricing, pitch, vision, state)
.planning/

# Claude Code workspace config & vendored GSD tooling (entire folder is internal)
.claude/

# Marketing / scratch experiments
Audio/
scripts/storytelling-video/

# WebSocket event-log runtime output (not source data); *.bak.json already ignored above
*.events.jsonl

# brag skill (testing) + its output
.agents/skills/brag
skills/brag/
brag-output*/

# scratch/temp outputs
temp/

# Hutch/Cottontail vendored toolchain (Electrobun 2.x) - native binaries, not source
.hutch/

# Cottontail build scratch (Electrobun 2.x) - per-PID temp, regenerated each build
.cottontail-tmp/

# Lockfiles from package managers other than bun (see scripts/verify-package-manager.js) -
# bun.lock is the only lockfile this repo tracks.
package-lock.json
pnpm-lock.yaml
yarn.lock
